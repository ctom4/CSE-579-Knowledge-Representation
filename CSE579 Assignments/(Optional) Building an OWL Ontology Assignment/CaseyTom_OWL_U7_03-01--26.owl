    <owl:Class rdf:about="http://www.semanticweb.org/casey/ontologies/2026/1/myPizza.owl#MeatyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/casey/ontologies/2026/1/myPizza.owl#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/casey/ontologies/2026/1/myPizza.owl#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/casey/ontologies/2026/1/myPizza.owl#MeatTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


